# Renomeie este arquivo para .env.local e preencha os valores.
# NUNCA suba o .env.local pro GitHub — ele já está no .gitignore do Next.js.

# 1. Chave do Google Gemini
#    Acesse: https://aistudio.google.com/apikey
#    Clique em "Create API Key", copie e cole aqui:
GEMINI_API_KEY=cole_sua_chave_gemini_aqui

# 2. URL do projeto Supabase
#    Acesse: https://supabase.com → seu projeto → Settings → API
#    Copie o campo "Project URL":
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# 3. Chave anônima do Supabase (anon/public)
#    Na mesma tela acima, copie o campo "anon public":
SUPABASE_ANON_KEY=cole_sua_chave_supabase_aqui
